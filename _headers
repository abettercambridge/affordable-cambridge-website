# Assets cache for a week; HTML re-checks every time so edits show up right away.
# PDFs in files/ cache for a day, since they may be replaced under the same name.
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=31536000, immutable
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/files/*
  Cache-Control: public, max-age=86400
